apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-prod
spec:
  acme:
    # ACME server URL for Let's Encrypt production environment
    server: https://acme-v02.api.letsencrypt.org/directory
    # Email used for ACME registration and renewal notifications
    email: <contact mail>
    # Name of the secret used to store the ACME account private key
    privateKeySecretRef:
      name: letsencrypt-prod-account-key
    solvers:
      - dns01:
          cloudflare:
            # The email associated with your Cloudflare account
            email: <account mail> 
            # Reference to the secret we created in Step 3.1.3
            apiTokenSecretRef:
              name: cloudflare-api-token-secret
              key: api-token
        # Optional: Apply this solver only to our domain
        selector:
          dnsZones:
            - "<your domain>"
