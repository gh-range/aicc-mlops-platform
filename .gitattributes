# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts
*.sh text eol=lf

# YAML files
*.yaml text eol=lf
*.yml text eol=lf

# Markdown
*.md text eol=lf

# Docker
Dockerfile text eol=lf

# Python
*.py text eol=lf

# Archives
*.zip binary
*.tar binary
*.gz binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
